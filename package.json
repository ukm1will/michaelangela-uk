{
  "name": "michaelangela-uk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.20.0"
  },
  "dependencies": {
    "@tippy.js/react": "^3.1.1",
    "bootstrap": "^4.1.1",
    "font-awesome": "^4.7.0",
    "lodash": "^4.17.21",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-router-dom": "^5.3.0",
    "react-scripts": "^5.0.1",
    "web-vitals": "^1.0.1",
    "wrangler": "^4.129.1"
  },
  "scripts": {
    "production": "cross-env NODE_ENV=production NODE_OPTIONS=--openssl-legacy-provider  node_modules/webpack/bin/webpack.js --progress --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js",
    "start": "react-scripts start",
    "build": "GENERATE_SOURCEMAP=false react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "preview:worker": "npm run build && wrangler dev",
    "deploy:worker": "npm run build && wrangler deploy"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.18.10"
  }
}
